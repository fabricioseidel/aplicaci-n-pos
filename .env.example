# Supabase — mismo proyecto que usa OlivoWeb (ref: nuuoooqfbuwodagvmmsf)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Fotos de producto tomadas en el POS (opcional). Las mismas tres de OlivoWeb:
# con ellas la foto va a Cloudinary (carpeta olivomarket/products), como las
# que sube OlivoWeb; sin ellas, al bucket público `uploads` de Supabase Storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
